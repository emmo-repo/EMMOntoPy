#!/usr/bin/env python3
"""Script for testing URL redirections.

The expected redirections are specified in a YAML file maping URLs to
expected redirections:

    # Optional base URL
    # This may e.g. be useful for local testing of w3id redirections.
    # See: https://docs.w3id.org/guides/testing#run-the-rules-locally
    base: https://w3id.org/emmo
    #base: http://localhost:8080/emmo

    # Redirections with no headers (backward compatibility)
    redirections:
      /:            https://emmo-repo.github.io/emmo.ttl
      /turtle:      https://emmo-repo.github.io/emmo.ttl
      /inferred:    https://emmo-repo.github.io/emmo-inferred.ttl
      "#Atom":      https://emmo-repo.github.io/emmo.ttl#Atom
      /1.1.0:       https://emmo-repo.github.io/versions/1.1.0/emmo.ttl

    # Redirections with headers
    requests:
      - headers:
          Accept: text/html
        redirections:
          /:        https://emmo-repo.github.io/emmo.html
          /turtle:  https://emmo-repo.github.io/emmo.ttl
          /1.1.0:   https://emmo-repo.github.io/versions/1.1.0/emmo.html
      - headers:
          Accept: text/turtle
        redirections:
          /:        https://emmo-repo.github.io/emmo.ttl
          /1.1.0:   https://emmo-repo.github.io/versions/1.1.0/emmo.ttl

"""

import sys
import argparse

import yaml
import requests


def test_all(yamlfile, conf=None):
    """Test all redirections specified in `yamlfile`.

    Arguments:
        yamlfile: File specifying redirections.
        conf: Dict with additional testing configurations.

    Returns:
        ok: Whether the redirection was successful.
    """
    with open(yamlfile, "r") as f:
        specifications = yaml.safe_load(f)

    conf = conf.copy() if conf else {}
    conf.setdefault("base", specifications.get("base", ""))
    verbose = int(conf.get("verbose", 1))

    ok = True
    for url, redirected_url in specifications["redirections"].items():
        ok &= test_redirection(url, redirected_url, conf=conf)

    for request in specifications.get("requests", []):
        conf["headers"] = request.get("headers")
        if verbose:
            print("# headers:", conf["headers"])
        for url, redirected_url in request["redirections"].items():
            ok &= test_redirection(url, redirected_url, conf=conf)

    return ok


def test_redirection(url, redirected_url, conf=None):
    """Test a redirection.

    Arguments:
        url: URL to test.
        redirected_url: Expected redirection.
        conf: Dict with additional testing configurations.

    Returns:
        ok: Whether the redirection was successful.
    """
    if conf is None:
        conf = {}
    verbose = int(conf.get("verbose", 1))
    timeout = float(conf["timeout"]) if "timeout" in conf else None
    fullurl = conf.get("base", "") + url

    try:
        r = requests.get(fullurl, headers=conf.get("headers"), timeout=timeout)
    except requests.Timeout:
        ok, reason, got = True, "timeout", None
    except requests.exceptions.SSLError as exc:
        ok, reason, got = False, str(exc), None
    except requests.exceptions.ConnectionError:
        ok, reason, got = False, "connection error", None
    else:
        if r.ok and r.url != redirected_url:
            ok, reason, got = False, "Invalid redirection", r.url
        elif r.reason == "Not Found" and not conf.get("check_found", True):
            ok, reason, got = True, f"OK ({r.reason})", None
        else:
            ok, reason, got = r.ok, r.reason, None

    if verbose:
        print(f"{fullurl:64} {reason}")
        if (got and verbose > 1) or verbose > 2:
            print(f"  got:      {got}")
            print(f"  expected: {redirected_url}")
            print()

    return ok


def main(argv: list = None):
    """Main function for running redirection tests."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "yamlfile",
        nargs="?",
        default="redirections.yaml",
        help="Name of YAML file specifying redirections to test.",
    )
    parser.add_argument(
        "--base",
        "-b",
        help=(
            "Base URL to prepend to all URLs. "
            "Overrides `base` in the yamlfile. "
            "This may e.g. be useful for local testing of w3id redirections. "
            "See: https://docs.w3id.org/guides/testing#run-the-rules-locally"
        ),
    )
    parser.add_argument(
        "--check-found",
        action="store_true",
        default=True,
        help="Fail if the redirected URL cannot be found (default).",
    )
    parser.add_argument(
        "--no-check-found",
        "-n",
        dest="check_found",
        action="store_false",
        help="Do not fail if the redirected URL cannot be found.",
    )
    parser.add_argument(
        "--verbose",
        "-v",
        action="count",
        default=1,
        help="Increase verbosity level. Max verbosity is -vv",
    )
    parser.add_argument(
        "--silent",
        "--quiet",
        "-q",
        action="store_const",
        const=0,
        dest="verbose",
        help="Whether to be silent.",
    )
    parser.add_argument(
        "--timeout",
        "-t",
        default="3",
        help="Number of seconds before timing out. Defaults to 3.",
    )
    args = parser.parse_args(args=argv)
    conf = {
        "verbose": args.verbose,
        "timeout": args.timeout,
        "check_found": args.check_found,
    }

    if args.base:
        conf["base"] = args.base

    return test_all(args.yamlfile, conf=conf)


if __name__ == "__main__":
    success = main()
    sys.exit(0 if success else 1)
